<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Qnx Mart</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>qnx_mart</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ═══════════ PERMISSIONS ═══════════ -->
	<!-- Camera: take logo & product photos -->
	<key>NSCameraUsageDescription</key>
	<string>QNX Mart needs camera access so you can take photos of your company logo and products.</string>

	<!-- Photo library: pick existing photos & videos -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>QNX Mart needs access to your photos so you can upload company logos, product images and videos.</string>

	<!-- Photo library: save photos (future use / share) -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>QNX Mart needs permission to save photos to your library.</string>

	<!-- Location: auto-fill business address -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>QNX Mart uses your location to auto-fill your business address and set your shipping pickup point.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>QNX Mart uses your location to auto-fill your business address and set your shipping pickup point.</string>

	<!-- Microphone: record videos with sound (product videos) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>QNX Mart needs microphone access to record product videos with sound.</string>

	<!-- Local network: dev server on the LAN (http://192.168.x.x) -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>QNX Mart connects to the QNX Mart server on your local network.</string>

	<!-- ═══════════ NETWORK ═══════════ -->
	<!-- https everywhere; plain http only for local-network IPs (dev server) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- ═══════════ LANGUAGES (English / मराठी / हिंदी) ═══════════ -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>mr</string>
		<string>hi</string>
	</array>

	<!-- ═══════════ OTHER APPS (url_launcher) ═══════════ -->
	<!-- WhatsApp, phone, email, SMS, Google Maps, Instagram links -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
		<string>tel</string>
		<string>mailto</string>
		<string>sms</string>
		<string>whatsapp</string>
		<string>comgooglemaps</string>
		<string>instagram</string>
	</array>

	<!-- ═══════════ APP CONFIG ═══════════ -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>